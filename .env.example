# ── VSS ──────────────────────────────────────────────────────────────────
# true  (default) → mocked responses, no GPU or deployment needed
# false           → hit the real LVS deployment at LVS_URL
USE_MOCK_VSS=true
MOCK_JOB_SECONDS=20

LVS_URL=http://localhost:38111
# VST must be reachable from the BROWSER — uploads go client → VST directly.
NEXT_PUBLIC_VST_URL=http://localhost:30000

NVIDIA_API_KEY=
NGC_API_KEY=



# ── database ─────────────────────────────────────────────────────────────
# Unset → in-memory store. Set after running `npm run db:setup`.
# DATABASE_URL=postgres://vi:vi@localhost:5432/video_intelligence
