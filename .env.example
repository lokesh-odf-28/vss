# ── VSS ──────────────────────────────────────────────────────────────────
# mock           (default) → mocked responses, no GPU, no deployment, no API key
# nvidia-hosted             → real NVIDIA-hosted VLM called directly
#                             (integrate.api.nvidia.com), no VSS deployment —
#                             needs NVIDIA_API_KEY and ffmpeg/ffprobe on PATH.
#                             Real file upload happens in this mode only.
# real                      → full VSS deployment at LVS_URL/RTVI_URL
# NEXT_PUBLIC_ because RunLauncher (client-side) reads it to decide whether
# to upload real bytes.
NEXT_PUBLIC_VSS_MODE=mock
MOCK_JOB_SECONDS=20

LVS_URL=http://localhost:38111
# RTVI (rt-vlm) — a separate microservice from LVS, needed for live camera
# registration (stream/add) and teardown. Live mode only.
RTVI_URL=http://localhost:8100
# VST must be reachable from the BROWSER — uploads go client → VST directly.
NEXT_PUBLIC_VST_URL=http://localhost:30000

# From https://build.nvidia.com/ — required for NEXT_PUBLIC_VSS_MODE=nvidia-hosted.
NVIDIA_API_KEY=
# Optional override; defaults to nvidia/nemotron-nano-12b-v2-vl (confirmed
# available on the public API catalog — see scripts/vlm-sanity-check.py).
NVIDIA_VLM_MODEL=
NGC_API_KEY=



# ── database ─────────────────────────────────────────────────────────────
# Unset → in-memory store. Set after running `npm run db:setup`.
# DATABASE_URL=postgres://vi:vi@localhost:5432/video_intelligence

# ── auth ─────────────────────────────────────────────────────────────────
# Signs the session cookie. Must be 32+ chars. Rotating it logs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ── mail (signup/reset OTP codes) ──────────────────────────────────────────
# Unset → OTP codes print to the server log instead of being emailed.
# Set all four to send real email over SMTP (Gmail, Office 365, SES SMTP, ...).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
